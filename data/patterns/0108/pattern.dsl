start: mr
R1: 3ch=dc 2ch {3dc 2ch 3dc 2ch 3dc 2ch 2dc}@ring ss@top # chain 5 = 1 dc + ch 2
R2: 3ch=dc [{2dc 2ch 2dc}@corner 3dc]x3 {2dc 2ch 2dc}@corner 2dc ss@top
R3: 3ch=dc 2dc [{2dc 2ch 2dc}@corner 7dc]x3 {2dc 2ch 2dc}@corner 4dc ss@top
R4: 3ch=dc 4dc [{2dc 2ch 2dc}@corner 11dc]x3 {2dc 2ch 2dc}@corner 6dc ss@top
R5: 3ch=dc [dc@st]>corner [{2dc 2ch 2dc}@corner [dc@st]>corner]x3 {2dc 2ch 2dc}@corner [dc@st]>end ss@top
