start: mr
R1: ch {[3dc ch]x4}@ring ss@top
R2: C2@{ch [{sc 3ch sc}@corner 2ch]x4 ss@top} # the stray "sc" after "ch 2" is not worked: the stated count is 8 sc
R3: ch [{3dc ch 3dc}@corner 3dc@sp]x4 ss@top
R4: C2@{ch [{sc 3ch sc}@corner 2ch [sc@sp 2ch]x2]x4 ss@top} # ch 2 after each sc between groups, so round 5 has 3dc for each ch-2 sp
R5-10: # alternate R3 and R4 (dc round, then sc round), three times each
R11: ch [{2sc ch 2sc}@corner [3sc@sp]>corner]x4 ss@top
